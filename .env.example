# Telegram app credentials — from https://my.telegram.org (API development tools)
YOUGRAM_API_ID=
YOUGRAM_API_HASH=

# Interface bot — from @BotFather
YOUGRAM_BOT_TOKEN=

# Only this Telegram user id may talk to the bot (your own numeric id)
YOUGRAM_ALLOWED_USER_ID=

# LLM: any Pydantic AI model string. Default below = Claude Haiku.
#   anthropic:claude-haiku-4-5  |  openai:gpt-4o-mini  |  google-gla:gemini-1.5-flash
YOUGRAM_LLM_MODEL=anthropic:claude-haiku-4-5

# Telethon session base name (a <name>.session file is created on first login)
YOUGRAM_SESSION_NAME=yougram

# Provider key for the chosen model (read by Pydantic AI directly, NO prefix):
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
